# Bot key: a FRESH key made with `npm run keygen`. Linked to your account in the app, it can
# place and reduce orders for you but can never withdraw. Leave blank for read-only.
BOT_PRIVATE_KEY=
# Your dreamDEX account (the wallet you trade with in the app). Address only, never a key.
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
# From @BotFather. Leave blank to run headless (notifications go to stdout).
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat ids allowed to control the bot. Send /start once to see yours.
ALLOWED_CHAT_IDS=
# Your bot's @username without the @, for share links.
BOT_USERNAME=
# true = log intended orders, send nothing. Set false to act.
DRY_RUN=true
MAX_ORDER_USD=100
SLIPPAGE_BPS=30
# Post every 15m candle decision, not just signals.
NOTIFY_EVERY_CANDLE=false

# Defaults are Hideki testnet (chain 50383); override only if they move.
# RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# WS_RPC_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
# INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
# EXPLORER_TX_URL=https://explorer.testnet.somnia.network/tokyo/tx/
# DB_PATH=data/riskguard.db
